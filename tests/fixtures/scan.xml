<?xml version="1.0"?>
<nmaprun scanner="nmap" args="nmap -sV --script ssl-enum-ciphers,ssl-cert,ssl-dh-params,ssl-heartbleed,ssl-poodle,sslv2-drown">
<host>
<status state="up"/>
<address addr="192.0.2.10" addrtype="ipv4"/>
<hostnames><hostname name="legacy.example.lab"/></hostnames>
<ports>
<port protocol="tcp" portid="443">
<state state="open"/>
<service name="https"/>
<script id="ssl-enum-ciphers" output="...">
  <table key="SSLv3">
    <table key="ciphers">
      <table><elem key="name">TLS_RSA_WITH_RC4_128_SHA</elem><elem key="kex_info">rsa 2048</elem><elem key="strength">C</elem>
        <table key="warnings"><elem>Broken cipher RC4 is deprecated by RFC 7465</elem></table></table>
      <table><elem key="name">TLS_RSA_WITH_3DES_EDE_CBC_SHA</elem><elem key="strength">D</elem>
        <table key="warnings"><elem>64-bit block cipher 3DES vulnerable to SWEET32 attack</elem></table></table>
    </table>
    <table key="warnings"><elem>CBC-mode cipher in SSLv3 (CVE-2014-3566)</elem></table>
  </table>
  <table key="TLSv1.0">
    <table key="ciphers">
      <table><elem key="name">TLS_RSA_WITH_AES_128_CBC_SHA</elem><elem key="strength">A</elem></table>
      <table><elem key="name">TLS_DH_anon_WITH_AES_128_CBC_SHA</elem><elem key="strength">F</elem></table>
    </table>
  </table>
  <table key="TLSv1.2">
    <table key="ciphers">
      <table><elem key="name">TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256</elem><elem key="strength">A</elem></table>
    </table>
  </table>
  <elem key="least strength">F</elem>
</script>
<script id="ssl-cert" output="Subject: commonName=legacy.example.lab">
  <table key="subject"><elem key="commonName">legacy.example.lab</elem></table>
  <table key="issuer"><elem key="commonName">legacy.example.lab</elem></table>
  <table key="pubkey"><elem key="type">rsa</elem><elem key="bits">1024</elem></table>
  <table key="validity"><elem key="notBefore">2018-01-01T00:00:00</elem><elem key="notAfter">2020-01-01T00:00:00</elem></table>
  <elem key="sig_algo">sha1WithRSAEncryption</elem>
</script>
<script id="ssl-dh-params" output="VULNERABLE: Diffie-Hellman Key Exchange Insufficient Group Strength">
  <table key="CVE-2015-4000"><elem key="title">Diffie-Hellman Key Exchange Insufficient Group Strength</elem><elem key="state">VULNERABLE</elem></table>
</script>
<script id="ssl-heartbleed" output="VULNERABLE: The Heartbleed Bug">
  <table key="CVE-2014-0160"><elem key="title">The Heartbleed Bug is a serious vulnerability in OpenSSL</elem><elem key="state">VULNERABLE</elem>
    <table key="ids"><table><elem key="type">cve</elem><elem key="value">CVE-2014-0160</elem></table></table></table>
</script>
<script id="ssl-poodle" output="VULNERABLE: SSL POODLE information leak">
  <table key="CVE-2014-3566"><elem key="title">SSL POODLE information leak</elem><elem key="state">VULNERABLE</elem></table>
</script>
</port>
</ports>
</host>
<host>
<status state="up"/>
<address addr="192.0.2.20" addrtype="ipv4"/>
<hostnames><hostname name="modern.example.lab"/></hostnames>
<ports>
<port protocol="tcp" portid="443">
<state state="open"/>
<service name="https"/>
<script id="ssl-enum-ciphers" output="...">
  <table key="TLSv1.3">
    <table key="ciphers"><table><elem key="name">TLS_AES_256_GCM_SHA384</elem><elem key="strength">A</elem></table></table>
  </table>
  <elem key="least strength">A</elem>
</script>
</port>
</ports>
</host>
</nmaprun>
